import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ---- 1. Load first 2 years data ----
df = pd.read_csv(r"C:\Users\nikhi\Downloads\rainfall_soil_temp_features_2020_2021.csv", parse_dates=["Date"])

# Filter for one district (Baksa)
district = "Baksa"
df = df[df['District'] == district].copy()

# ---- 2. Fill missing Rainfall_mm with 0 ----
df['Rainfall_mm'] = df['Rainfall_mm'].fillna(0)

# ---- 3. Compute expected rainfall baseline from first 2 years ----
monthly_baseline = df.groupby(['Month'])['Rainfall_mm'].mean().reset_index()
monthly_baseline = monthly_baseline.rename(columns={'Rainfall_mm': 'Expected_rainfall'})

# Merge expected rainfall into first 2 years (for analysis if needed)
df = df.merge(monthly_baseline, on='Month', how='left')

# Compute anomalies on training data
df['Anomaly'] = df['Rainfall_mm'] - df['Expected_rainfall']

# Compute statistical threshold based on anomalies in first 2 years
mean_anomaly = df['Anomaly'].mean()
std_anomaly = df['Anomaly'].std()
threshold = 1.5 * std_anomaly

print(f"Anomaly threshold set at ±{threshold:.2f} mm (2 std deviations)")

# ---- 4. Load 3rd year data ----
df3 = pd.read_csv(r"C:\Users\nikhi\Downloads\rainfall_soil_2022_features.csv", parse_dates=["Date"])

# Filter same district
df3 = df3[df3['District'] == district].copy()

# Fill missing Rainfall_mm with 0
df3['Rainfall_mm'] = df3['Rainfall_mm'].fillna(0)

# Add expected rainfall from monthly baseline
df3 = df3.merge(monthly_baseline, on='Month', how='left')

# Compute anomalies for 3rd year
df3['Anomaly'] = df3['Rainfall_mm'] - df3['Expected_rainfall']

# Flag anomalies: anomaly beyond ± threshold
df3['Predicted_Anomaly'] = df3['Anomaly'].abs() > threshold

# Print summary of anomalies
num_anomalies = df3['Predicted_Anomaly'].sum()
print(f"Detected {num_anomalies} anomalies in 3rd year data for {district}")

import matplotlib.dates as mdates

plt.figure(figsize=(14,6))
plt.plot(df3['Date'], df3['Rainfall_mm'], label='Observed Rainfall')
plt.plot(df3['Date'], df3['Expected_rainfall'], label='Expected Rainfall', linestyle='--')
plt.scatter(df3['Date'][df3['Predicted_Anomaly']],
            df3['Rainfall_mm'][df3['Predicted_Anomaly']],
            color='red', label='Detected Anomaly', marker='x')

# Format x-axis to show months
plt.gca().xaxis.set_major_locator(mdates.MonthLocator())
plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%b'))

plt.legend()
plt.title(f'Rainfall & Detected Anomalies for District: {district} (3rd Year)')
plt.xlabel('Month')
plt.ylabel('Rainfall (mm)')
plt.tight_layout()
plt.show()

# ---- 6. Optional: Save anomalies to CSV ----
df3.to_csv(f"predicted_anomalies_{district}.csv", index=False)
print(f"Predicted anomalies saved to predicted_anomalies_{district}.csv")
